.safe-area{position:fixed;left:0;right:0;bottom:0;z-index:90;background:#F7F4ED;padding:0 18rpx env(safe-area-inset-bottom)}.floating-bar{background:#fffdf9;border:1rpx solid #e7ddeb;border-bottom:0;border-radius:45rpx 45rpx 0 0;box-shadow:0 -10rpx 35rpx #51256705;display:flex;justify-content:space-around;padding:17rpx 14rpx 15rpx}.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:5rpx;color:#a098a6;font-size:20rpx}.icon-pad{display:flex;align-items:center;justify-content:center;width:78rpx;height:56rpx;border-radius:21rpx}.tab-icon{width:45rpx;height:45rpx}.tab.active{color:#512567;font-weight:600}.active .icon-pad{background:#eee4f1}
