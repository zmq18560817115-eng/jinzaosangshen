<view class="page {{page==='home'||page==='map'||page==='passport'||page==='mine'?'tab-page':''}}">
 <block wx:if="{{page==='home'}}">
  <view class="location">⌖ 广东 · 汕头 · 潮阳金灶 <text bindtap="go" data-page="garden">示范果园 ›</text></view>
  <view class="orchard-cover"><image class="scene" src="/assets/orchard-hero-v2.jpg" mode="aspectFill"/><view class="cover-tag"><image src="/assets/icons/leaf.png" class="tiny-icon"/>水土之间，自然有趣</view><view class="ip-bubble"><image src="/assets/zaozao-source.png" mode="aspectFit"/></view></view><view class="welcome-panel"><view class="sheet-handle"></view><text class="eyebrow">HELLO, MULBERRY SEASON</text><view class="hero-title"><view>跟着灶灶桑</view><view>去果园撒个欢</view></view><view class="hero-desc">采一篮果香，收集一路的小美好。</view><button class="primary hero-btn" bindtap="go" data-page="routes">开启我的桑旅 <image src="/assets/icons/arrow-white.png" class="button-arrow"/></button></view>
  <view class="quick-actions"><view class="quick" bindtap="go" data-page="booking"><view class="quick-icon purple"><image src="/assets/icons/calendar.png"/></view>预约采摘</view><view class="quick" bindtap="go" data-page="map"><view class="quick-icon green"><image src="/assets/icons/map.png"/></view>果园地图</view><view class="quick" bindtap="go" data-page="passport"><view class="quick-icon blue"><image src="/assets/icons/passport.png"/></view>游园护照</view><view class="quick" bindtap="go" data-page="basket"><view class="quick-icon orange"><image src="/assets/icons/bag.png"/></view>我的这一篮</view></view>
  <view class="section-heading">选一条喜欢的路 <text bindtap="go" data-page="routes">全部路线 ›</text></view>
  <view wx:for="{{routes}}" wx:key="id" class="route-card" bindtap="chooseRoute" data-id="{{item.id}}" data-next="true"><view class="route-image"><image src="/assets/orchard-hero-v2.jpg" mode="aspectFill"/><text class="chip {{item.color}}">{{item.tag}}</text><text class="route-number">路线 {{index+1}}</text></view><view class="route-body"><view class="h3">{{item.name}}</view><view class="muted">{{item.desc}}</view><view class="route-meta">{{item.duration}} · 5 个探索节点 <image class="tiny-icon" src="/assets/icons/arrow.png"/></view></view></view>
  <view class="companion"><view>每一篮果香，都来自农人的用心。</view><view>在体验里，认识土地与种植者。</view></view>
 </block>
 <block wx:if="{{page==='welcome'}}"><view class="welcome"><image src="/assets/brand-source.png" mode="aspectFit" class="welcome-logo"/><view class="h1">金灶桑旅</view><text class="eyebrow">JINZAO · MULBERRY JOURNEY</text><image class="welcome-mascot" src="/assets/zaozao-source.png" mode="aspectFit"/><view class="muted"><view>跟着灶灶桑，体验一颗桑葚</view><view>从枝头到生活的旅程。</view></view><button class="primary" bindtap="go" data-page="home">带上好奇心，出发 →</button></view></block>
 <block wx:if="{{page==='garden'}}"><view class="page-head"><text class="eyebrow">ABOUT THE ORCHARD</text><view class="h2">果香，在这里发生</view><view class="muted">一座示范果园 · 一次完整桑旅体验</view></view><view class="node-hero green"><view class="h2">从土地，走到生活</view><view>采摘 · 科普 · 工坊 · 果香记忆</view></view><view class="card"><view class="h3">这次可以怎么玩？</view><view class="body">选择主题路线，探索五个节点，认识水土与桑树，学习采摘，了解加工，再为这一篮留下专属纪念。</view><view class="info-row"><text>地点</text><text>金灶示范果园（规划）</text></view><view class="info-row"><text>导览时长</text><text>约60–75分钟（规划）</text></view><view class="info-row"><text>演示时段</text><text>09:00 / 14:00</text></view><view class="info-row"><text>费用</text><text>现场确认 · 原型不收款</text></view></view><view class="card"><view class="h3">来之前准备这些</view><view class="body">穿舒适防滑鞋，携带饮用水。儿童由成人陪同，只在开放区域采摘。雷雨或湿滑时听从园区安排。</view><button class="secondary" bindtap="go" data-page="safety">采摘与安全说明</button></view><button class="primary" bindtap="go" data-page="booking">预约我的桑旅</button></block>
 <block wx:if="{{page==='routes'}}"><view class="page-head"><text class="eyebrow">CHOOSE YOUR JOURNEY</text><view class="h2">走一条自己的桑旅</view><view class="muted">两条路线，五个节点；慢慢走，也能有收获。</view></view><view wx:for="{{routes}}" wx:key="id" class="route-card {{route.id===item.id?'selected':''}}" bindtap="chooseRoute" data-id="{{item.id}}"><view class="route-image"><image src="/assets/orchard-hero-v2.jpg" mode="aspectFill"/><text class="chip {{item.color}}">{{item.tag}}</text><text class="route-number">路线 {{index+1}}</text></view><view class="route-body"><view class="h3">{{item.name}}</view><view class="muted">{{item.desc}}</view><view class="route-meta">{{item.duration}} · 5个节点 <text>{{route.id===item.id?'已选择':'→'}}</text></view></view></view><view class="card"><view class="h3">这一路会遇见</view><view class="route-stops"><view wx:for="{{ordered}}" wx:key="id"><view class="stop-num">{{index+1}}</view><text>{{item.short}}</text></view></view><view class="chips"><text wx:for="{{route.features}}" wx:key="*this" class="chip {{route.color}}">{{item}}</text></view><view class="muted">时间为规划估算，根据同行者体力、天气与园区安排调整。</view></view><button class="primary" bindtap="start">跟着这条路线出发 →</button></block>
 <block wx:if="{{page==='map'}}"><view class="page-head"><text class="eyebrow">EXPLORE THE ORCHARD</text><view class="h2">果园里的小冒险</view><view class="muted">{{route.name}} · 已探索 {{count}}/5 站</view></view><view class="segmented"><view wx:for="{{routes}}" wx:key="id" class="{{route.id===item.id?'active':''}}" bindtap="chooseRoute" data-id="{{item.id}}">{{item.id==='nature'?'自然探索线':'果香体验线'}}</view></view><view class="map-panel"><image class="map-art" src="/assets/orchard-map-v2.jpg" mode="scaleToFill"/><view class="map-label">手绘规划示意 · 不提供实时定位</view><view wx:for="{{nodes}}" wx:key="id" class="map-node" style="left:{{item.x}}%;top:{{item.y}}%;" bindtap="nodeGo" data-id="{{item.id}}"><view class="pin {{item.earned?'earned':''}}"><image src="{{'/assets/icons/'+(item.earned?'check-white':item.icon)+'.png'}}" mode="aspectFit"/><text class="pin-seq">{{item.seq}}</text></view><text>{{item.name}}</text></view></view><view class="facilities"><text bindtap="facility" data-name="洗手间">洗手间</text><text bindtap="facility" data-name="休息区">休息区</text><text bindtap="facility" data-name="服务台">服务台</text><text bindtap="go" data-page="scan">⌗ 扫码</text></view><view class="section-heading">下一站，去哪里？<text bindtap="go" data-page="routes">换路线 ›</text></view><view wx:for="{{ordered}}" wx:key="id" class="node-row" bindtap="nodeGo" data-id="{{item.id}}"><view class="node-num {{item.color}}">{{item.earned?'✓':item.seq}}</view><view><view class="node-name">{{item.name}}</view><view class="small">{{item.earned?'已获得印章':item.subtitle}} · {{item.time}}</view></view><text class="chevron">›</text></view></block>
 <block wx:if="{{page==='node'}}"><view class="node-hero {{node.color}}"><text class="eyebrow">EXPLORE · {{node.id}}</text><view class="h2">{{node.name}}</view><view>{{node.subtitle}} · {{node.time}}</view></view><view class="card"><view class="section-heading">灶灶桑说 <text bindtap="voice">文字讲解</text></view><view class="body">{{node.story}}</view></view><view class="card"><view class="h3">土地的小知识</view><view class="body">{{node.fact}}</view><view class="note" bindtap="go" data-page="sources">依据：{{node.source}} ›</view></view><view class="companion">完成小任务，收集这一站的专属印章。</view><view class="actions"><button class="secondary" bindtap="go" data-page="map">回到地图</button><button class="primary" bindtap="go" data-page="task">开始小任务 →</button></view></block>
 <block wx:if="{{page==='task'}}"><view class="page-head"><text class="eyebrow">LITTLE MISSION · {{node.id}}</text><view class="h2">{{node.stamp}}小任务</view><view class="muted">答错也没关系，灶灶桑陪你再试一次。</view></view><view class="card"><text class="chip {{node.color}}">{{node.name}}</text><view class="question">{{node.question}}</view><button wx:for="{{node.options}}" wx:key="*this" class="answer {{feedback.index===index?(feedback.ok?'right':'wrong'):''}}" bindtap="answer" data-index="{{index}}"><text class="answer-letter">{{index===0?'A':index===1?'B':'C'}}</text>{{item}}</button><view wx:if="{{feedback}}" class="feedback {{feedback.ok?'':'error'}}">{{feedback.text}}<view wx:if="{{feedback.ok}}" class="small">{{node.explain}}</view></view></view><view wx:if="{{feedback.ok}}" class="actions"><button class="secondary" bindtap="go" data-page="passport">查看护照</button><button class="primary" bindtap="next">下一站 →</button></view><button wx:else class="secondary" bindtap="go" data-page="node">返回节点介绍</button></block>
 <block wx:if="{{page==='passport'}}"><view class="passport-cover"><text class="eyebrow">ZAOZAO'S EXPLORER PASSPORT</text><view class="h2">灶灶桑游园护照</view><view class="small">{{t?t.date+' · '+t.id:'属于你的第一段果园故事'}}</view><view class="passport-count">{{count}}<text>/ 5 枚自然印章</text></view><view class="progress"><view style="width:{{count*20}}%"></view></view></view><view class="section-heading">收集一路的发现<text bindtap="go" data-page="scan">⌗ 扫码探索</text></view><view class="stamps"><view wx:for="{{nodes}}" wx:key="id" class="stamp {{item.earned?'earned':''}}" bindtap="nodeGo" data-id="{{item.id}}"><view class="stamp-medal"><image src="{{'/assets/icons/'+item.icon+'.png'}}" class="stamp-icon"/><text class="stamp-name">{{item.stamp}}</text></view><view>{{item.earned?'已点亮':item.name}}</view></view></view><view class="companion">{{count===5?'五枚印章，五次发现。把旅程收藏起来吧。':'每一站都有自己的小故事。离园后保留已有印章。'}}</view><button class="primary" bindtap="go" data-page="{{count===5?'memory':'map'}}">{{count===5?'生成纪念卡':'继续探索 →'}}</button><view class="section-heading">我的体验成果</view><view class="node-row" bindtap="go" data-page="basket"><view class="node-num orange"><image src="/assets/icons/bag.png" class="small-icon"/></view><view><view class="node-name">我的这一篮</view><view class="small">{{t.weight?'已确认 '+t.weight.kg+' kg':'记录采摘照片与成果'}}</view></view><text class="chevron">›</text></view></block>
 <block wx:if="{{page==='booking'}}"><view class="page-head"><text class="eyebrow">PLAN A LITTLE ESCAPE</text><view class="h2">预约一份果香</view><view class="muted">安排好时间，把好奇心带进果园。</view></view><view class="card"><view class="label">来访日期</view><picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="dateChange"><view class="field">{{date}} ›</view></picker><view class="label">体验时段</view><picker range="{{slotLabels}}" bindchange="slotChange"><view class="field">{{slot==='morning'?slotLabels[0]:slotLabels[1]}} ›</view></picker><view class="label">同行人数</view><view class="counter"><button bindtap="count" data-delta="-1">−</button><text>{{people}}</text><button bindtap="count" data-delta="1">+</button></view><view class="label">游客昵称</view><input class="field" value="{{nickname}}" maxlength="20" placeholder="灶灶桑怎么称呼你？" bindinput="field" data-key="nickname"/><view class="label">体验内容</view><picker range="{{projects}}" bindchange="projectChange"><view class="field">{{project}} ›</view></picker><view class="note">模拟预约，不收款、不占用真实名额；开放安排以现场确认为准。</view><button class="primary" bindtap="book">确认演示预约</button></view></block>
 <block wx:if="{{page==='ticket'}}"><block wx:if="{{t.booking}}"><view class="page-head"><text class="eyebrow">YOUR LITTLE GETAWAY</text><view class="h2">预约已准备好</view></view><view class="card"><view class="ticket-top">{{t.admitted?'✓ 已核验入园':'期待与你在果园相见'}}</view><image src="/assets/qr-ticket.png" class="ticket-qr" mode="aspectFit"/><view class="ticket-code">{{t.id}}</view><view class="info-row"><text>游客</text><text>{{t.booking.nickname}}</text></view><view class="info-row"><text>日期</text><text>{{t.booking.date}}</text></view><view class="info-row"><text>人数</text><text>{{t.booking.people}} 人</text></view><view class="info-row"><text>时段</text><text>{{t.booking.slot==='morning'?'09:00':'14:00'}}</text></view><view class="info-row"><text>入园状态</text><text>{{t.booking.status}}</text></view><view class="note">演示核验码 · 预约编号由工作人员核对</view></view><view class="actions"><button class="secondary" bindtap="go" data-page="staff">演示到园核验</button><button class="primary" bindtap="go" data-page="map">先看看地图</button></view></block><view wx:else class="card empty"><view class="h3">还没有预约凭证</view><button class="primary" bindtap="go" data-page="booking">去预约</button></view></block>
 <block wx:if="{{page==='scan'}}"><view class="page-head"><text class="eyebrow" decode="{{true}}">SCAN &amp; DISCOVER</text><view class="h2">扫一扫，遇见新发现</view></view><view class="scan-box"><image src="/assets/icons/scan.png" class="scan-icon"/></view><button class="primary" bindtap="scan">扫描实体导览二维码</button><view class="card"><view class="label">手动输入节点码</view><input class="field" placeholder="sanglv:N01 或 N01" bindinput="field" data-key="scanInput"/><button class="secondary" bindtap="manualScan">识别节点码</button></view><view class="section-heading">选择一块导览牌试试</view><view wx:for="{{nodes}}" wx:key="id" class="node-row" bindtap="simulateScan" data-id="{{item.id}}"><view class="node-num {{item.color}}">{{item.no}}</view><view><view class="node-name">{{item.name}}</view><view class="small">演示扫码 · sanglv:{{item.id}}</view></view><text class="chevron">›</text></view></block>
 <block wx:if="{{page==='safety'}}"><view class="page-head"><text class="eyebrow">PICK WITH CARE</text><view class="h2">轻轻采，慢慢玩</view><view class="muted">照顾同行者，也照顾每一颗桑葚。</view></view><view class="card"><view class="h3">采摘三步走</view><view class="rule">01 确认品种与成熟特征，听工作人员示范。</view><view class="rule">02 按指导轻轻采摘，不拉扯、不攀爬。</view><view class="rule">03 轻放入篮，不挤压，由工作人员称重。</view></view><view class="card"><view class="h3">这几件事，要记住</view><view class="body">只进入开放区域，儿童由成人陪同。雷雨或地面湿滑时听从园区安排。采后按现场食用与清洗指引处理，不适时向服务台求助。</view></view><button class="primary" bindtap="go" data-page="map">我知道啦，去探索 ✓</button></block>
 <block wx:if="{{page==='basket'}}"><view class="page-head"><text class="eyebrow">MY LITTLE HARVEST</text><view class="h2">我的这一篮</view><view class="muted">一篮果香，也是今天的小小成就。</view></view><block wx:if="{{t}}"><view class="card"><view class="photo-upload" bindtap="photo"><image wx:if="{{t.photo}}" src="{{t.photo}}" mode="aspectFill"/><block wx:else><image class="photo-symbol" src="/assets/icons/camera.png"/><view>留下今天的采摘照片</view><view class="small">点击上传 · 仅保存在本地</view></block></view><view class="info-row"><text>旅程</text><text>{{t.id}}</text></view><view class="info-row"><text>日期</text><text>{{t.date}}</text></view><view class="info-row"><text>印章</text><text>{{count}} / 5</text></view></view><view class="card"><view class="h3">采摘重量</view><view class="weight">{{t.weight?t.weight.kg:'—'}} <text>kg</text></view><view class="muted">{{t.weight?'工作人员已确认 · 演示记录':'请交给工作人员称重，结果会同步到这里。'}}</view><view class="note" bindtap="go" data-page="staff">打开工作人员称重演示 ›</view></view><view class="actions"><button class="secondary" bindtap="go" data-page="memory">生成纪念卡</button><button class="primary" bindtap="go" data-page="service" disabled="{{!t.weight}}">选择成果去向</button></view></block><view wx:else class="card empty"><view class="h3">先开启一段桑旅吧</view><button class="primary" bindtap="go" data-page="routes">选择体验路线</button></view></block>
 <block wx:if="{{page==='service'}}"><view class="page-head"><text class="eyebrow">KEEP THE FRUIT AROUND</text><view class="h2">这一篮，想去哪里？</view></view><block wx:if="{{t.weight}}"><view class="card"><view class="info-row"><text>已确认重量</text><text>{{t.weight.kg}} kg</text></view></view><view class="service-choice {{serviceType==='take'?'selected':''}}" bindtap="chooseService" data-id="take"><view class="h3">现场带走</view><view class="muted">装好这一篮，带回家的餐桌</view></view><view class="service-choice {{serviceType==='jam'?'selected':''}}" bindtap="chooseService" data-id="jam"><view class="h3">果酱体验</view><view class="muted">提交工坊体验意向，等待现场确认</view></view><view class="service-choice {{serviceType==='send'?'selected':''}}" bindtap="chooseService" data-id="send"><view class="h3">冷链寄送意向</view><view class="muted">费用与时效由工作人员确认</view></view><view class="service-choice disabled"><view class="h3">桑葚酒制作 · 暂未开放</view><view class="muted">可咨询工作人员了解其他项目</view></view><view wx:if="{{serviceType==='send'}}" class="card"><view class="label">收件人（测试信息）</view><input class="field" bindinput="field" data-key="recipient" value="{{recipient}}" maxlength="30" placeholder="测试姓名"/><view class="label">电话</view><input class="field" bindinput="field" data-key="phone" value="{{phone}}" type="number" maxlength="11" placeholder="测试手机号"/><view class="label">地址</view><textarea class="field" bindinput="field" data-key="address" value="{{address}}" maxlength="200" placeholder="测试地址"/></view><view class="note">仅登记演示意向，不付款、不发货；不承诺48小时物流。</view><button class="primary" bindtap="submitService">提交体验服务意向 →</button></block><view wx:else class="card empty"><view class="h3">先确认这一篮的重量</view><button class="primary" bindtap="go" data-page="staff">打开工作人员端</button></view></block>
 <block wx:if="{{page==='status'}}"><view class="page-head"><text class="eyebrow">YOUR FRUIT, ON ITS WAY</text><view class="h2">果香服务进度</view></view><block wx:if="{{t.service}}"><view class="card"><text class="chip purple">{{serviceName}}</text><view class="h3">{{t.service.status}}</view><view class="info-row"><text>申请</text><text>{{t.service.id}}</text></view><view wx:for="{{t.service.history}}" wx:key="at" class="timeline-item">● {{item.status}}</view><view class="note">本地演示，未连接真实物流与服务端。</view></view><view class="actions"><button class="secondary" bindtap="go" data-page="staff">演示人员接收</button><button class="primary" bindtap="go" data-page="memory">收藏旅程</button></view><view wx:if="{{t.service.status!=='已完成' && t.service.status!=='已取消'}}" class="note" bindtap="cancel">取消当前申请</view></block><view wx:else class="card empty"><view class="h3">还没有服务申请</view><button class="primary" bindtap="go" data-page="basket">查看这一篮</button></view></block>
 <block wx:if="{{page==='memory'}}"><view class="page-head"><text class="eyebrow">A MEMORY TO TAKE HOME</text><view class="h2">把今天，收藏起来</view></view><block wx:if="{{t}}"><view class="memory-card"><text class="eyebrow">JINZAO · MULBERRY JOURNEY</text><view class="memory-title">这一篮，很金灶</view><view class="muted">果香有来处，旅程有记忆。</view><view class="memory-photo"><image src="{{t.photo||'/assets/zaozao-source.png'}}" mode="{{t.photo?'aspectFill':'aspectFit'}}"/></view><view class="memory-label">{{t.booking?t.booking.nickname:'桑旅探索者'}} · {{t.date}}</view><view class="mini-stamps"><text wx:for="{{earned}}" wx:key="id">{{item.stamp}}</text></view><view class="info-row"><text>{{count}} 枚自然印章</text><text>{{t.weight?t.weight.kg+' kg 果香':'一份自然好奇心'}}</text></view><view class="memory-bottom"><view>跟着灶灶桑，从枝头到生活。</view><view>{{t.id}} · 设计原型体验记录</view></view></view><view class="actions"><button class="primary" bindtap="saveMemory">保存到相册</button><button class="secondary" bindtap="go" data-page="basket">补充照片</button></view><canvas id="memoryCanvas" type="2d" class="export-canvas"/></block><view wx:else class="card empty"><view class="h3">今天的故事还没开始</view><button class="primary" bindtap="go" data-page="routes">开启我的桑旅</button></view></block>
 <block wx:if="{{page==='gifts'}}"><view class="page-head"><text class="eyebrow">TAKE A LITTLE SWEETNESS</text><view class="h2">把果香，带回家</view></view><view class="segmented"><view wx:for="{{['全部','鲜果','工坊','文创']}}" wx:key="*this" bindtap="filter" data-name="{{item}}" class="{{giftFilter===item?'active':''}}">{{item}}</view></view><view class="gift-grid"><view wx:for="{{gifts}}" wx:key="name" class="gift-card" bindtap="gift" data-name="{{item.name}}"><view class="gift-art {{item.color}}"><image src="{{item.kind==='文创'?'/assets/zaozao-source.png':'/assets/brand-source.png'}}" mode="aspectFit"/></view><view class="gift-info"><view class="h3">{{item.name}}</view><view class="small">{{item.desc}}</view><view class="note">{{item.note}}</view></view></view></view><view class="note">仅作概念展示，不提供真实购买与付款。</view></block>
 <block wx:if="{{page==='mine'}}"><view class="profile"><image src="/assets/zaozao-source.png" mode="aspectFit"/><view><view class="h2">{{t.booking?t.booking.nickname:'桑旅探索者'}}</view><view class="small">和土地打招呼，和果香交朋友。</view></view></view><view class="stats"><view><text>{{state.trips.length}}</text>我的旅程</view><view><text>{{count}}</text>本程印章</view><view><text>{{t.weight?t.weight.kg:'—'}}</text>采摘 kg</view></view><view class="card"><view class="menu" bindtap="go" data-page="ticket">我的预约 <text>›</text></view><view class="menu" bindtap="go" data-page="basket">采摘档案 <text>›</text></view><view class="menu" bindtap="go" data-page="status">体验服务进度 <text>›</text></view><view class="menu" bindtap="go" data-page="memory">旅程纪念卡 <text>›</text></view><view class="menu" bindtap="go" data-page="gifts">果香伴手礼 <text>›</text></view><view class="menu" bindtap="go" data-page="staff">工作人员演示 <text>›</text></view><view class="menu" bindtap="go" data-page="sources">内容与数据来源 <text>›</text></view><view class="menu" bindtap="go" data-page="welcome">品牌欢迎页 <text>›</text></view></view><view class="section-heading">过去的桑旅<text bindtap="newTrip">新旅程 +</text></view><view wx:for="{{history}}" wx:key="id" class="trip-item {{state.activeId===item.id?'selected':''}}" bindtap="switchTrip" data-id="{{item.id}}"><view>{{item.date}} · {{item.stamps.length}} 枚印章<view class="small">{{item.id}}</view></view><text>{{item.id===state.activeId?'当前':'查看'}}</text></view><view class="note">数据仅保存在当前设备；不同游客不共享。</view></block>
 <block wx:if="{{page==='staff'}}"><view class="page-head"><text class="eyebrow">ORCHARD SERVICE DESK</text><view class="h2">园区工作台</view></view><view class="staff-banner">工作人员演示 · 本设备共用本地旅程。正式上线需身份认证、权限与服务端。</view><block wx:if="{{t}}"><view class="card"><view class="h3">当前旅程</view><view class="info-row"><text>编号</text><text>{{t.id}}</text></view><view class="info-row"><text>游客</text><text>{{t.booking?t.booking.nickname:'匿名探索者'}}</text></view><view class="info-row"><text>预约</text><text>{{t.booking?t.booking.date+' / '+t.booking.people+' 人':'未预约'}}</text></view><button class="primary" bindtap="checkin" disabled="{{!t.booking||t.admitted}}">{{t.admitted?'已核验入园':t.booking?'确认预约并核验入园':'请先完成演示预约'}}</button><button wx:if="{{!t.booking}}" class="secondary" bindtap="go" data-page="booking">登记预约</button></view><view class="card"><view class="h3">称重登记</view><view class="label">现场确认重量（kg）</view><input class="field" type="digit" value="{{weightInput}}" bindinput="field" data-key="weightInput" placeholder="例如 1.25" disabled="{{!t.admitted}}"/><view class="note">登记后同步到游客档案，仅演示操作。</view><button class="primary" bindtap="weigh" disabled="{{!t.admitted}}">保存称重记录</button></view><view class="card"><view class="h3">加工与寄送申请</view><block wx:if="{{t.service}}"><view class="info-row"><text>项目</text><text>{{serviceName}}</text></view><view class="info-row"><text>状态</text><text>{{t.service.status}}</text></view><block wx:if="{{t.service.type==='send'}}"><view class="info-row"><text>收件人</text><text>{{t.service.recipient}}</text></view><view class="info-row"><text>电话</text><text>{{t.service.phone}}</text></view><view class="info-row"><text>地址</text><text>{{t.service.address}}</text></view></block><button wx:if="{{t.service.status==='已提交待确认'}}" class="primary" bindtap="setStatus" data-status="工作人员已接收">接收服务申请</button><button wx:if="{{t.service.status==='工作人员已接收'}}" class="primary" bindtap="setStatus" data-status="已完成">标记服务已完成</button></block><view wx:else class="muted">游客尚未提交服务意向。</view></view><button class="secondary" bindtap="go" data-page="basket">查看游客档案</button></block><view wx:else class="card empty"><view class="h3">当前还没有旅程</view><button class="primary" bindtap="go" data-page="booking">登记演示预约</button></view></block>
 <block wx:if="{{page==='sources'}}"><view class="page-head"><text class="eyebrow">ROOTED IN JINZAO</text><view class="h2">有来处的果香</view></view><view class="card"><view class="h3">课程品牌资产</view><view class="body">金灶桑葚 Logo、灶灶桑二维形象提取自课程 PDF 第15、17页。配色：桑葚紫 #512567、浅桑紫 #A77BB9、水蓝 #A8D2D7、自然绿 #50835B、暖米白 #F7F4ED。</view></view><view class="card"><view class="h3">产地资料</view><view class="body">金灶为桑葚、杨梅、橄榄等水果的产地与集散地。</view><view class="note" bindtap="copySource" data-url="https://youth.shantou.gov.cn/youth/tqkd/202006/073370b3701748279be61a816b9caae9.shtml">汕头市共青团 · 2020-06-02（复制来源链接）</view><view class="body">订单农业、品质管理、小包装和采后预冷的产地实践。</view><view class="note" bindtap="copySource" data-url="https://www.szss.gov.cn/sstbhzq/ssw/hlss/lp/content/post_11842629.html">深汕网 · 2024-12-03（复制来源链接）</view></view><view class="card"><view class="h3">原型范围</view><view class="body">一座果园、两条路线、五个节点为设计规划；预约、称重和服务为本地演示，不含真实支付、物流、GPS或多用户同步。未把产业面积、糖度与成分数据作为真实承诺。</view></view></block>
 <view class="note footer-note">金灶桑旅 V1.2 · 园区、路线与服务为规划演示</view>
</view>
